# Copia a .env.aula (no se sube a git) y ejecuta: ./scripts/deploy-aula.sh

# Contraseña para añadir canciones. Quien no entre como admin solo escucha.
AULA_ADMIN_PASSWORD=cambia-esta-contraseña

# Carpeta de canciones del aula, distinta de ./music del catálogo.
# AULA_MUSIC_HOST_PATH=/ruta/en/el/hp/music-aula

# Título visible. Por defecto: Aula de canto
# AULA_SITE_TITLE=Aula de canto

# Ruta al proyecto quitar-voz en el host. Por defecto: ../quitarvoces
# QUITAR_VOZ_HOST_PATH=../quitarvoces
